# Copy this file to .env and fill in local values.
# Never commit real API keys or credentials.

OPENAI_API_KEY=

# Optional frontend-style name. Backend code should prefer OPENAI_API_KEY
# and may fall back to this value for local compatibility.
VITE_OPENAI_API_KEY=

# Optional model override for standalone agents.
OPENAI_MODEL=gpt-4.1-mini
