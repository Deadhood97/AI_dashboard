# Copy this file to .env and fill in local values.
# Never commit real API keys or credentials.

OPENAI_API_KEY=

# Optional frontend-style name. Backend code should prefer OPENAI_API_KEY
# and may fall back to this value for local compatibility.
VITE_OPENAI_API_KEY=

# Optional shared model override for all agents.
OPENAI_MODEL=gpt-4.1-mini

# Optional role-specific model overrides. These take precedence over OPENAI_MODEL.
# Use these to test stronger models for code-heavy stages without making every
# agent more expensive.
OPENAI_SEMANTIC_MODEL=
OPENAI_METRIC_CODE_MODEL=gpt-4.1
OPENAI_METRIC_REPAIR_MODEL=gpt-4.1
OPENAI_DASHBOARD_MODEL=gpt-4.1
OPENAI_DASHBOARD_CRITIC_MODEL=gpt-4.1
OPENAI_INSIGHTS_MODEL=

# Optional LLM transport guardrails.
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1

# Optional notebook audit trail. Disabled by default so the dashboard path
# remains unchanged unless explicitly enabled.
ENABLE_NOTEBOOK_VIEW=false

# Optional Kaggle imports. You can also use `kaggle auth login`
# or place the official token file in your user Kaggle config folder.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
