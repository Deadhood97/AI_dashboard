# Copy this file to .env and fill in local values.
# Never commit real API keys or credentials.

OPENAI_API_KEY=

# Optional frontend-style name. Backend code should prefer OPENAI_API_KEY
# and may fall back to this value for local compatibility.
VITE_OPENAI_API_KEY=

# Optional model override for standalone agents.
OPENAI_MODEL=gpt-4.1-mini

# Optional notebook audit trail. Disabled by default so the dashboard path
# remains unchanged unless explicitly enabled.
ENABLE_NOTEBOOK_VIEW=false

# Optional Kaggle imports. You can also use `kaggle auth login`
# or place the official token file in your user Kaggle config folder.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
